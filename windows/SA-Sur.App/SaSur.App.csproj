<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>SaSur.App</RootNamespace>
    <!-- The shipped file is SA-Sur.exe, not SaSur.App.exe. -->
    <AssemblyName>SA-Sur</AssemblyName>
    <!-- The app's own icon, embedded so File Explorer, the taskbar and Alt-Tab show it rather than
         the generic .NET one. Written by windows/packaging/make-assets.sh from the same composed
         artwork the macOS build puts in AppIcon.icns, so the two platforms cannot drift. -->
    <ApplicationIcon>SA-Sur.ico</ApplicationIcon>

    <!-- A self-contained publish carries a .NET runtime in the download, so trim what the app
         cannot reach: the untrimmed class library includes XML, Data and expression-tree code that
         a frequency calculator never calls. partial rather than full leaves Avalonia and this
         project's own assemblies byte-identical to an untrimmed build, so the shipped UI stack is
         exactly the one that was run and measured on Windows. -->
    <!-- One product version across the three channels from 1.2.0: the GitHub download, the Mac App
         Store build and this Store package all say 1.2.0. The MSIX pads it to four parts (1.2.0.0)
         because that is what the package schema requires. Build numbers are internal and never
         appear in prose. See docs/RELEASE.md. -->
    <Version>1.2.0</Version>
    <ApplicationIcon>SA-Sur.ico</ApplicationIcon>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AssemblyTitle>SA-Sur : Note to Frequency</AssemblyTitle>
    <Product>SA-Sur</Product>
    <Company>Hafod Mastering Limited and Sudeep Audio.com LLP</Company>
    <Copyright>© 2026 Hafod Mastering Limited and Sudeep Audio.com LLP</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Two jobs, two items: ApplicationIcon above brands the .exe, and this makes the same bytes
         loadable as an Avalonia asset so Window.Icon can use it. -->
    <AvaloniaResource Include="SA-Sur.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />

    <!-- Pinned forward of the 0.21.2 that Avalonia.Desktop resolves transitively: CVE-2026-39959,
         fixed in 0.21.3. The vulnerable code is the Linux D-Bus transport and is unreachable in a
         Windows build, but shipping a package with an open high-severity advisory in a signed
         installer is not a defensible position. Same minor line, so nothing else moves. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SA-Sur.Ui\SaSur.Ui.csproj" />
    <ProjectReference Include="..\SA-Sur.Audio\SaSur.Audio.csproj" />
  </ItemGroup>

</Project>
